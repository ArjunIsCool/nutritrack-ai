rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sessionIsCurrent(userId) {
      let sessionDoc = /databases/$(database)/documents/users/$(userId)/private/session;
      return !exists(sessionDoc) || request.auth.token.auth_time > get(sessionDoc).data.revokedAfter;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId && sessionIsCurrent(userId);
    }
  }
}
