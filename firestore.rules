rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sessionIsCurrent(userId) {
      let sessionDoc = /databases/$(database)/documents/users/$(userId)/private/session;
      return !exists(sessionDoc)
        || request.auth.token.auth_time >= get(sessionDoc).data.get('revokedAfter', 0);
    }

    // The session cutoff is server-managed only. Never grant clients access to
    // users/{uid}/private/session, otherwise a user could clear their own cutoff.
    match /users/{userId}/private/profile {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && sessionIsCurrent(userId);
    }

    match /users/{userId}/meals/{mealId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && sessionIsCurrent(userId);
    }
  }
}
