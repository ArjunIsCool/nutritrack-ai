{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nutritrack-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "preview_urls": true,
  "previews": {
    "vars": {
      "FIREBASE_PROJECT_ID": "nutritrack-ai-6337e"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "nutritrack-ai-usage",
        "database_id": "74007f8b-3706-4bb8-993e-677db7956ff9"
      }
    ],
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutritrack-ai-usage",
      "database_id": "74007f8b-3706-4bb8-993e-677db7956ff9",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
